<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Main Dashboard Template -->
    <t t-name="dh_tms_intelligence_dashboard.MainDashboard">
        <div class="tms-intelligence-dashboard-container">
            <!-- Header Bar with Filter Bar & Export Buttons -->
            <div class="dashboard-header-bar">
                <div class="dashboard-title-box">
                    <h2><i class="fa fa-tachometer mr-2"/>TMS Fleet &amp; Tire Intelligence Command Center</h2>
                    <p>Real-Time Telemetry, Wear Heatmap, CPKM Benchmarks &amp; Predictive Maintenance Alerts</p>
                </div>

                <!-- Dynamic Hub & Vehicle Type Filter Bar -->
                <div class="dashboard-controls">
                    <t t-if="widget.filters &amp;&amp; widget.filters.operating_units &amp;&amp; widget.filters.operating_units.length">
                        <select class="form-control form-control-sm js_filter_unit" style="max-width: 180px;">
                            <option value="">-- All Operating Hubs --</option>
                            <t t-foreach="widget.filters.operating_units" t-as="ou">
                                <option t-att-value="ou.id" t-att-selected="widget.selected_unit_id == ou.id ? 'selected' : None">
                                    <t t-esc="ou.name"/>
                                </option>
                            </t>
                        </select>
                    </t>

                    <t t-if="widget.filters &amp;&amp; widget.filters.truck_types &amp;&amp; widget.filters.truck_types.length">
                        <select class="form-control form-control-sm js_filter_truck_type" style="max-width: 180px;">
                            <option value="">-- All Vehicle Types --</option>
                            <t t-foreach="widget.filters.truck_types" t-as="tt">
                                <option t-att-value="tt.id" t-att-selected="widget.selected_truck_type_id == tt.id ? 'selected' : None">
                                    <t t-esc="tt.name"/>
                                </option>
                            </t>
                        </select>
                    </t>

                    <button class="btn btn-secondary btn-sm js_export_pdf_report">
                        <i class="fa fa-file-pdf-o mr-1"/> Export Executive PDF
                    </button>
                    <button class="btn btn-dashboard-refresh btn-sm js_refresh_dashboard">
                        <i class="fa fa-refresh mr-1"/> Refresh
                    </button>
                </div>
            </div>

            <!-- 4 Interactive Executive KPI Cards (Drilldown Enabled) -->
            <div class="kpi-cards-grid">
                <div class="kpi-card kpi-active-vehicles js_drilldown_fleet" style="cursor: pointer;" title="Click to drill down to Vehicle list">
                    <div class="kpi-icon"><i class="fa fa-truck"/></div>
                    <div class="kpi-details">
                        <span class="kpi-title">Active Fleet Units</span>
                        <span class="kpi-value"><t t-esc="widget.kpis.active_vehicles"/> / <t t-esc="widget.kpis.total_vehicles"/></span>
                        <span class="kpi-subtitle"><t t-esc="widget.kpis.operational_pct"/>% Operational Readiness &gt;</span>
                    </div>
                </div>

                <div class="kpi-card kpi-mounted-tires js_drilldown_mounted_tires" style="cursor: pointer;" title="Click to drill down to Mounted Tires">
                    <div class="kpi-icon"><i class="fa fa-circle-o-notch"/></div>
                    <div class="kpi-details">
                        <span class="kpi-title">Active Mounted Tires</span>
                        <span class="kpi-value"><t t-esc="widget.kpis.total_mounted_tires"/> / <t t-esc="widget.kpis.total_expected_tires"/></span>
                        <span class="kpi-subtitle">Position Ratio Tracked &gt;</span>
                    </div>
                </div>

                <div class="kpi-card kpi-wear-alerts js_drilldown_wear_alerts" style="cursor: pointer;" title="Click to drill down to Wear Alerts list">
                    <div class="kpi-icon"><i class="fa fa-exclamation-triangle"/></div>
                    <div class="kpi-details">
                        <span class="kpi-title">Wear &amp; PSI Alerts</span>
                        <span class="kpi-value text-danger"><t t-esc="widget.kpis.critical_tires"/> Critical</span>
                        <span class="kpi-subtitle"><t t-esc="widget.kpis.warning_tires"/> Warnings Needing Action &gt;</span>
                    </div>
                </div>

                <div class="kpi-card kpi-cpkm js_drilldown_cpkm" style="cursor: pointer;" title="Click to drill down to CPKM Tire Usage">
                    <div class="kpi-icon"><i class="fa fa-line-chart"/></div>
                    <div class="kpi-details">
                        <span class="kpi-title">Avg Fleet CPKM</span>
                        <span class="kpi-value"><t t-esc="widget.kpis.avg_cpkm"/></span>
                        <span class="kpi-subtitle">Tire Lifecycle Efficiency &gt;</span>
                    </div>
                </div>
            </div>

            <!-- Main Content Grid -->
            <div class="dashboard-main-grid">
                <!-- Left Column: Vehicle Health Quick Grid -->
                <div class="dashboard-panel">
                    <div class="panel-header">
                        <h3>
                            <i class="fa fa-th-large mr-2"/>Vehicle Fleet Telemetry Quick-Grid
                            <t t-if="widget.active_filter_state">
                                <span class="badge badge-warning ml-2">Filtered: <t t-esc="widget.active_filter_state.toUpperCase()"/></span>
                                <button class="btn btn-link btn-sm js_clear_wear_filter">(Clear Filter)</button>
                            </t>
                        </h3>
                        <span class="badge badge-info"><t t-esc="widget.filtered_vehicle_grid.length"/> Vehicles</span>
                    </div>

                    <div class="vehicle-cards-container">
                        <t t-if="widget.filtered_vehicle_grid &amp;&amp; widget.filtered_vehicle_grid.length">
                            <t t-foreach="widget.filtered_vehicle_grid" t-as="v">
                                <div class="vehicle-quick-card js_open_chassis_diagram" t-att-data-vehicle-id="v.id">
                                    <div class="v-card-top">
                                        <span class="v-card-nopol"><t t-esc="v.nopol"/></span>
                                        <span t-attf-class="health-badge #{v.health_state}">
                                            <t t-esc="v.health_state.toUpperCase()"/>
                                        </span>
                                    </div>
                                    <div class="v-card-type"><t t-esc="v.truck_type"/> | Lambung: <t t-esc="v.nomor_lambung"/></div>
                                    <div class="v-card-bottom">
                                        <span>Mounted Ratio: <strong><t t-esc="v.mounted_count"/>/<t t-esc="v.expected_count"/></strong></span>
                                        <span class="text-primary font-weight-bold">View Chassis Diagram &gt;</span>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="p-3 text-center text-muted">No vehicles matching active filter criteria.</div>
                        </t>
                    </div>
                </div>

                <!-- Right Column: Interactive Wear Donut Chart & Predictive Widgets -->
                <div class="dashboard-panel">
                    <!-- Interactive Wear Heatmap Filter -->
                    <div class="panel-header">
                        <h3><i class="fa fa-pie-chart mr-2"/>Fleet Tire Wear Distribution Heatmap</h3>
                        <small class="text-muted">(Click segment to filter quick-grid)</small>
                    </div>

                    <!-- Donut Ring Chart -->
                    <div class="donut-chart-container mb-3" style="display: flex; align-items: center; justify-content: space-around; padding: 10px 0;">
                        <div style="position: relative; width: 130px; height: 130px;">
                            <svg width="130" height="130" viewBox="0 0 100 100" style="transform: rotate(-90deg);">
                                <circle cx="50" cy="50" r="40" fill="transparent" stroke="#e9ecef" stroke-width="12"/>
                                <circle cx="50" cy="50" r="40" fill="transparent" stroke="#28a745" stroke-width="12" class="js_filter_wear_state" data-state="normal" style="cursor: pointer;"
                                        t-att-stroke-dasharray="widget.wear_distribution.normal_dash + ' ' + widget.wear_distribution.circumference"
                                        stroke-dashoffset="0"/>
                                <circle cx="50" cy="50" r="40" fill="transparent" stroke="#ffc107" stroke-width="12" class="js_filter_wear_state" data-state="warning" style="cursor: pointer;"
                                        t-att-stroke-dasharray="widget.wear_distribution.warning_dash + ' ' + widget.wear_distribution.circumference"
                                        t-att-stroke-dashoffset="'-' + widget.wear_distribution.normal_dash"/>
                                <circle cx="50" cy="50" r="40" fill="transparent" stroke="#dc3545" stroke-width="12" class="js_filter_wear_state" data-state="critical" style="cursor: pointer;"
                                        t-att-stroke-dasharray="widget.wear_distribution.critical_dash + ' ' + widget.wear_distribution.circumference"
                                        t-att-stroke-dashoffset="'-' + (widget.wear_distribution.normal_dash + widget.wear_distribution.warning_dash)"/>
                            </svg>
                            <div style="position: absolute; top: 0; left: 0; width: 130px; height: 130px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;">
                                <span style="font-size: 18px; font-weight: 800; color: #2c3e50;"><t t-esc="widget.kpis.total_mounted_tires"/></span>
                                <span style="font-size: 9px; font-weight: 600; color: #6c757d; text-transform: uppercase;">Mounted</span>
                            </div>
                        </div>

                        <!-- Donut Legend (Clickable Filters) -->
                        <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
                            <div class="js_filter_wear_state" data-state="normal" style="cursor: pointer;" title="Click to filter Normal tires">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background-color: #28a745; margin-right: 6px;"/>
                                <span>🟢 Normal (&gt;6.0mm): <strong><t t-esc="widget.kpis.normal_tires"/></strong> (<t t-esc="widget.wear_distribution.normal_pct"/>%)</span>
                            </div>
                            <div class="js_filter_wear_state" data-state="warning" style="cursor: pointer;" title="Click to filter Warning tires">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background-color: #ffc107; margin-right: 6px;"/>
                                <span>🟡 Warning (3.1-6.0mm): <strong><t t-esc="widget.kpis.warning_tires"/></strong> (<t t-esc="widget.wear_distribution.warning_pct"/>%)</span>
                            </div>
                            <div class="js_filter_wear_state" data-state="critical" style="cursor: pointer;" title="Click to filter Critical tires">
                                <span style="display: inline-block; width: 12px; height: 12px; border-radius: 3px; background-color: #dc3545; margin-right: 6px;"/>
                                <span>🔴 Critical (&lt;=3.0mm): <strong><t t-esc="widget.kpis.critical_tires"/></strong> (<t t-esc="widget.wear_distribution.critical_pct"/>%)</span>
                            </div>
                        </div>
                    </div>

                    <!-- Real-Time Tire Pressure (PSI) Telemetry Matrix -->
                    <div class="panel-header mt-3">
                        <h3>
                            <i class="fa fa-tachometer mr-2"/>Real-Time Tire Pressure (PSI) Telemetry
                        </h3>
                        <span class="badge badge-info js_drilldown_psi_alerts" style="cursor: pointer;" title="Click to view PSI telemetry detail">
                            <t t-esc="widget.psi_distribution.total_tracked"/> Mounted Tracked &gt;
                        </span>
                    </div>
                    <div class="psi-matrix-container p-2 mb-3" style="background: #f8f9fa; border-radius: 8px;">
                        <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 600;">
                            <span>Tire Pressure Status</span>
                            <span>
                                <span class="text-success mr-2">🟢 Standard (<t t-esc="widget.psi_distribution.normal_count"/>)</span>
                                <span class="text-warning mr-2">🟡 Low (<t t-esc="widget.psi_distribution.low_count"/>)</span>
                                <span class="text-danger">🔴 Critical (<t t-esc="widget.psi_distribution.critical_count"/>)</span>
                            </span>
                        </div>
                        <div class="progress" style="height: 14px; border-radius: 7px; overflow: hidden;">
                            <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: ' + widget.psi_distribution.normal_pct + '%'" t-att-title="'Normal PSI: ' + widget.psi_distribution.normal_count + ' tires (' + widget.psi_distribution.normal_pct + '%)'"/>
                            <div class="progress-bar bg-warning" role="progressbar" t-att-style="'width: ' + widget.psi_distribution.low_pct + '%'" t-att-title="'Low PSI: ' + widget.psi_distribution.low_count + ' tires (' + widget.psi_distribution.low_pct + '%)'"/>
                            <div class="progress-bar bg-danger" role="progressbar" t-att-style="'width: ' + widget.psi_distribution.critical_pct + '%'" t-att-title="'Critical PSI: ' + widget.psi_distribution.critical_count + ' tires (' + widget.psi_distribution.critical_pct + '%)'"/>
                        </div>
                        <div class="d-flex justify-content-between mt-2 text-muted" style="font-size: 11px;">
                            <span>Standard: &gt;= 100 PSI</span>
                            <span>Low: 85 - 99 PSI</span>
                            <span>Critical: &lt; 85 PSI</span>
                        </div>
                    </div>

                    <!-- Automated Tire Rotation Opportunities Widget -->
                    <div class="panel-header mt-3">
                        <h3><i class="fa fa-retweet mr-2"/>Recommended Tire Rotation Opportunities</h3>
                    </div>
                    <div class="alert-queue-list mb-3">
                        <t t-if="widget.rotation_recommendations &amp;&amp; widget.rotation_recommendations.length">
                            <t t-foreach="widget.rotation_recommendations" t-as="rot">
                                <div class="alert-item-card warning js_open_chassis_diagram" t-att-data-vehicle-id="rot.vehicle_id">
                                    <div class="alert-title-row">
                                        <span><i class="fa fa-refresh mr-1"/><t t-esc="rot.action"/></span>
                                        <span class="text-muted"><t t-esc="rot.vehicle_name"/></span>
                                    </div>
                                    <p class="alert-msg"><t t-esc="rot.reason"/></p>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="p-2 text-center text-muted" style="background-color: #f8f9fa; border-radius: 4px;">
                                <i class="fa fa-check mr-1"/> Steer axle tires currently balanced within equal wear tolerances.
                            </div>
                        </t>
                    </div>

                    <!-- Predictive Tire Lifespan Replacement Forecaster -->
                    <div class="panel-header mt-3">
                        <h3><i class="fa fa-calendar-check-o mr-2"/>Predictive Replacement Forecaster (Next 30 Days)</h3>
                    </div>
                    <div class="alert-queue-list">
                        <t t-if="widget.replacement_forecast &amp;&amp; widget.replacement_forecast.length">
                            <t t-foreach="widget.replacement_forecast" t-as="f">
                                <div t-attf-class="alert-item-card #{f.urgency} js_open_chassis_diagram" t-att-data-vehicle-id="f.vehicle_id">
                                    <div class="alert-title-row">
                                        <span><t t-esc="f.vehicle_name"/> (Pos <t t-esc="f.pos_code"/>) — Est: <t t-esc="f.est_days"/></span>
                                        <span class="badge badge-danger">RTD <t t-esc="f.rtd"/> mm</span>
                                    </div>
                                    <p class="alert-msg">Serial: <t t-esc="f.serial_number"/> | Priority tire replacement forecast.</p>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="p-2 text-center text-muted" style="background-color: #f8f9fa; border-radius: 4px;">
                                <i class="fa fa-shield mr-1"/> All mounted fleet tires have sufficient remaining tread depth.
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- CPK Billing Projections & Min-KM Floor Deficit Panel -->
            <div class="dashboard-panel mb-4">
                <div class="panel-header" style="flex-wrap: wrap; gap: 10px;">
                    <h3>
                        <i class="fa fa-money mr-2"/>Monthly CPK Billing Projections &amp; Min-KM Guarantee Floor Deficit
                    </h3>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span class="badge badge-info">Period: <t t-esc="widget.cpk_billing_summary.periode_str"/></span>
                        <button class="btn btn-primary btn-sm js_open_billing_wizard">
                            <i class="fa fa-file-text-o mr-1"/> Generate CPK Billing Recap Wizard
                        </button>
                    </div>
                </div>

                <!-- 4 Financial Metric Badges -->
                <div class="financial-metrics-grid mb-3" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;">
                    <div class="coupling-card text-center p-3" style="background: #eef4ff; border-radius: 8px; border-left: 4px solid #1e62d0;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Projected Billing Revenue</div>
                        <div style="font-size: 20px; font-weight: 800; color: #1e62d0;"><t t-esc="widget.cpk_billing_summary.projected_billing_str"/></div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Estimated CPK Billing Output</div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #e8f8ec; border-radius: 8px; border-left: 4px solid #28a745;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">CPK Contract Hubs</div>
                        <div style="font-size: 20px; font-weight: 800; color: #28a745;"><t t-esc="widget.cpk_billing_summary.cpk_hubs"/> Operating Units</div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Billing Eligible Locations</div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #fffdf2; border-radius: 8px; border-left: 4px solid #ffc107;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Under-Utilized Units</div>
                        <div style="font-size: 20px; font-weight: 800; color: #d97706;"><t t-esc="widget.cpk_billing_summary.deficit_vehicle_count"/> Vehicles</div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Distance Below Min-KM Guarantee</div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #fdf2f2; border-radius: 8px; border-left: 4px solid #dc3545;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Min-KM Deficit Guarantee Value</div>
                        <div style="font-size: 20px; font-weight: 800; color: #dc3545;"><t t-esc="widget.cpk_billing_summary.adjustment_str"/></div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Revenue Floor Recovery Amount</div>
                    </div>
                </div>

                <!-- Under-Utilized Vehicles Table -->
                <h4 style="font-size: 14px; font-weight: 700; color: #495057; margin-bottom: 10px;">
                    Under-Utilized Vehicles Operating Below Min-KM Floor Guarantee (&lt; 2,500 KM)
                </h4>
                <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                    <table class="brand-table">
                        <thead>
                            <tr>
                                <th>Vehicle Unit</th>
                                <th>Hub Location</th>
                                <th class="text-right">Actual Distance (KM)</th>
                                <th class="text-right">Min Guarantee (KM)</th>
                                <th class="text-right">Deficit Gap (KM)</th>
                                <th class="text-center">Mounted Tires</th>
                                <th class="text-right">CPK Rate</th>
                                <th class="text-right">Guarantee Revenue Adjustment</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="widget.min_km_deficit_vehicles &amp;&amp; widget.min_km_deficit_vehicles.length">
                                <t t-foreach="widget.min_km_deficit_vehicles" t-as="dv">
                                    <tr class="js_open_chassis_diagram" t-att-data-vehicle-id="dv.vehicle_id" style="cursor: pointer;" title="Click to view vehicle chassis diagram">
                                        <td><strong><t t-esc="dv.nomor_lambung"/></strong></td>
                                        <td><t t-esc="dv.hub_name"/></td>
                                        <td class="text-right"><t t-esc="dv.km_aktual.toLocaleString()"/> km</td>
                                        <td class="text-right"><t t-esc="dv.min_threshold.toLocaleString()"/> km</td>
                                        <td class="text-right font-weight-bold text-danger">(<t t-esc="dv.deficit_km.toLocaleString()"/> km)</td>
                                        <td class="text-center"><t t-esc="dv.tire_count"/></td>
                                        <td class="text-right">Rp <t t-esc="dv.cpk_rate"/></td>
                                        <td class="text-right font-weight-bold text-success"><t t-esc="dv.adjustment_str"/></td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="8" class="text-center text-muted p-3">
                                        <i class="fa fa-check-circle text-success mr-1"/> All active vehicles in CPK billing hubs have met or exceeded minimum guaranteed distance thresholds.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Trailer Coupling & Exchange Telemetry Panel -->
            <div class="dashboard-panel mb-4">
                <div class="panel-header">
                    <h3><i class="fa fa-truck mr-2"/>Trailer Exchange &amp; Fleet Coupling Telemetry</h3>
                    <button class="btn btn-link btn-sm js_drilldown_trailer_exchanges">View All Exchanges &gt;</button>
                </div>

                <!-- Coupling Metric Badges -->
                <div class="coupling-metrics-grid mb-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
                    <div class="coupling-card text-center p-3" style="background: #eef4ff; border-radius: 8px; border-left: 4px solid #1e62d0;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Head Units (Prime Movers)</div>
                        <div style="font-size: 22px; font-weight: 800; color: #1e62d0;"><t t-esc="widget.trailer_coupling_summary.total_heads"/></div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #e8f8ec; border-radius: 8px; border-left: 4px solid #28a745;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Connected Trailers</div>
                        <div style="font-size: 22px; font-weight: 800; color: #28a745;">
                            <t t-esc="widget.trailer_coupling_summary.connected_trailers"/> / <t t-esc="widget.trailer_coupling_summary.total_trailers"/>
                            <small style="font-size: 12px; font-weight: 600;">(<t t-esc="widget.trailer_coupling_summary.coupling_pct"/>%)</small>
                        </div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #fff8e6; border-radius: 8px; border-left: 4px solid #ffc107;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Uncoupled Idle Trailers</div>
                        <div style="font-size: 22px; font-weight: 800; color: #d97706;"><t t-esc="widget.trailer_coupling_summary.uncoupled_trailers"/></div>
                    </div>
                </div>

                <!-- Recent Trailer Exchange Feed -->
                <h4 style="font-size: 14px; font-weight: 700; color: #495057; margin-bottom: 10px;">Recent Trailer Exchange Log Activity</h4>
                <div class="alert-queue-list" style="max-height: 240px;">
                    <t t-if="widget.recent_trailer_exchanges &amp;&amp; widget.recent_trailer_exchanges.length">
                        <t t-foreach="widget.recent_trailer_exchanges" t-as="ex">
                            <div class="alert-item-card js_open_trailer_exchange" t-att-data-exchange-id="ex.id" style="border-left-color: #1e62d0; background-color: #f0f4fc; cursor: pointer;">
                                <div class="alert-title-row">
                                    <span><i class="fa fa-exchange mr-1"/><t t-esc="ex.name"/> — <t t-esc="ex.head_name"/></span>
                                    <span class="badge badge-info"><t t-esc="ex.state.toUpperCase()"/></span>
                                </div>
                                <p class="alert-msg">
                                    Swapped: <span class="text-muted"><t t-esc="ex.previous_trailer"/></span> &amp;rarr; <strong><t t-esc="ex.new_trailer"/></strong> | Odo: <strong><t t-esc="ex.odometer ? ex.odometer.toLocaleString() : '0'"/> km</strong> | Hub: <t t-esc="ex.location"/>
                                </p>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="p-3 text-center text-muted" style="background-color: #f8f9fa; border-radius: 6px;">
                            <i class="fa fa-info-circle mr-1"/> No recent trailer exchange logs recorded.
                        </div>
                    </t>
                </div>
            </div>

            <!-- Bottom Section: Advanced Brand Performance Benchmarking & Interactive Panel Filter -->
            <div class="dashboard-panel">
                <div class="panel-header" style="flex-wrap: wrap; gap: 10px;">
                    <h3><i class="fa fa-bar-chart mr-2"/>Tire Brand &amp; Pattern Performance Benchmarks</h3>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <!-- Category Filter Dropdown -->
                        <select class="form-control form-control-sm js_filter_brand_category" style="max-width: 150px;">
                            <option value="">All Categories</option>
                            <option value="original" t-att-selected="widget.active_brand_category == 'original' ? 'selected' : None">Original Tires</option>
                            <option value="retread" t-att-selected="widget.active_brand_category == 'retread' ? 'selected' : None">Retread Tires</option>
                        </select>

                        <!-- Sorting Dimension Dropdown -->
                        <select class="form-control form-control-sm js_filter_brand_sort" style="max-width: 170px;">
                            <option value="mileage" t-att-selected="widget.active_brand_sort == 'mileage' ? 'selected' : None">Sort by Mileage (High)</option>
                            <option value="cpkm" t-att-selected="widget.active_brand_sort == 'cpkm' ? 'selected' : None">Sort by CPKM (Best Leader)</option>
                            <option value="count" t-att-selected="widget.active_brand_sort == 'count' ? 'selected' : None">Sort by Serials Count</option>
                        </select>

                        <span class="badge badge-primary"><t t-esc="widget.filtered_brand_performance.length"/> Brands</span>
                        <t t-if="widget.best_brand_leader &amp;&amp; widget.best_brand_leader != '-'">
                            <span class="badge badge-success">Top Leader: <t t-esc="widget.best_brand_leader"/></span>
                        </t>
                    </div>
                </div>

                <table class="brand-table">
                    <thead>
                        <tr>
                            <th style="width: 22%;">Tire Brand</th>
                            <th style="width: 40%;">Average Mileage Comparison (KM)</th>
                            <th style="width: 18%;" class="text-right">Cost per KM (CPKM)</th>
                            <th style="width: 20%;" class="text-center">Performance Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="widget.filtered_brand_performance &amp;&amp; widget.filtered_brand_performance.length">
                            <t t-foreach="widget.filtered_brand_performance" t-as="b">
                                <tr class="js_drilldown_brand" t-att-data-brand-id="b.brand_id" t-att-data-brand-name="b.brand" style="cursor: pointer;" title="Click to view tire inventory for this brand">
                                    <td>
                                        <strong><t t-esc="b.brand"/></strong>
                                        <span class="badge badge-light ml-1"><t t-esc="b.count"/> Serials</span>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <div style="flex: 1; height: 16px; background-color: #e9ecef; border-radius: 8px; overflow: hidden;">
                                                <div t-attf-style="width: #{b.bar_pct}%; height: 100%; background: linear-gradient(90deg, #1e62d0, #28a745); border-radius: 8px; transition: width 0.5s ease;"/>
                                            </div>
                                            <span style="font-weight: bold; font-size: 11px; min-width: 70px; text-align: right;">
                                                <t t-esc="b.avg_km ? b.avg_km.toLocaleString() : '0'"/> km
                                            </span>
                                        </div>
                                    </td>
                                    <td class="text-right font-weight-bold text-success"><t t-esc="b.cost_per_km"/></td>
                                    <td class="text-center">
                                        <span t-attf-class="badge #{b.badge_class}">
                                            <t t-esc="b.badge_text"/>
                                        </span>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="4" class="text-center text-muted p-3">
                                    No brand performance records matching active panel filter criteria.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>
    </t>
</templates>
