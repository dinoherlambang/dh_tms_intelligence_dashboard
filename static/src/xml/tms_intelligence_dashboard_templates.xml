<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Main Dashboard Template -->
    <t t-name="dh_tms_intelligence_dashboard.MainDashboard">
        <div class="tms-intelligence-dashboard-container">
            <!-- Header Bar with Filter Bar & Export Buttons -->
            <div class="dashboard-header-bar">
                <div class="dashboard-title-box">
                    <h2><i class="fa fa-tachometer mr-2"/>TMS Fleet &amp; Tire Intelligence Command Center</h2>
                    <p>Real-Time Telemetry, Wear Heatmap, CPKM Benchmarks &amp; Predictive Maintenance Alerts</p>
                </div>

                <!-- Dynamic Hub & Vehicle Type Filter Bar -->
                <div class="dashboard-controls">
                    <t t-if="widget.filters &amp;&amp; widget.filters.operating_units &amp;&amp; widget.filters.operating_units.length">
                        <select class="form-control form-control-sm js_filter_unit" style="max-width: 180px;">
                            <option value="">-- All Operating Hubs --</option>
                            <t t-foreach="widget.filters.operating_units" t-as="ou">
                                <option t-att-value="ou.id" t-att-selected="widget.selected_unit_id == ou.id ? 'selected' : None">
                                    <t t-esc="ou.name"/>
                                </option>
                            </t>
                        </select>
                    </t>

                    <t t-if="widget.filters &amp;&amp; widget.filters.truck_types &amp;&amp; widget.filters.truck_types.length">
                        <select class="form-control form-control-sm js_filter_truck_type" style="max-width: 180px;">
                            <option value="">-- All Vehicle Types --</option>
                            <t t-foreach="widget.filters.truck_types" t-as="tt">
                                <option t-att-value="tt.id" t-att-selected="widget.selected_truck_type_id == tt.id ? 'selected' : None">
                                    <t t-esc="tt.name"/>
                                </option>
                            </t>
                        </select>
                    </t>

                    <button class="btn btn-secondary btn-sm js_export_pdf_report">
                        <i class="fa fa-file-pdf-o mr-1"/> Export Executive PDF
                    </button>
                    <button class="btn btn-dashboard-refresh btn-sm js_refresh_dashboard">
                        <i class="fa fa-refresh mr-1"/> Refresh
                    </button>
                </div>
            </div>

            <!-- Monitoring Executive KPI Cards Grid -->
            <div class="row mb-3">
                <!-- Card 1: Monitoring Inspections Activity -->
                <div class="col-xl-3 col-md-6 col-12 mb-3 mb-xl-0">
                    <div class="kpi-card kpi-mounted-tires js_open_monitoring_list" style="cursor: pointer; height: 100%;" title="Click to view all Inspection Logs">
                        <div class="kpi-icon" style="background: #e6f7ff; color: #007bff;"><i class="fa fa-clipboard"/></div>
                        <div class="kpi-details">
                            <span class="kpi-title">Monitoring Records</span>
                            <span class="kpi-value"><t t-esc="widget.kpis.total_inspections or 0"/> Logs</span>
                            <span class="kpi-subtitle"><t t-esc="widget.kpis.active_vehicles or 0"/> Fleet Units Inspected &gt;</span>
                        </div>
                    </div>
                </div>

                <!-- Card 2: Combined Box for Installed, Rotated, and Removed Tires -->
                <div class="col-xl-4 col-md-6 col-12 mb-3 mb-xl-0">
                    <div class="chart-box p-3 h-100" style="background: #ffffff; border: 1px solid #e9ecef; border-left: 4px solid #1e62d0; border-radius: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong style="font-size: 11px; font-weight: 700; color: #1e62d0; text-transform: uppercase;">
                                <i class="fa fa-sync-alt mr-1"/> Tire Lifecycle Movements
                            </strong>
                            <span class="badge badge-light text-muted" style="font-size: 10px;">Operational Status</span>
                        </div>
                        <div class="row text-center align-items-center mt-2">
                            <div class="col-4 border-right pr-1 pl-1">
                                <div class="text-success font-weight-bold" style="font-size: 17px;">
                                    <i class="fa fa-plus-circle mr-1" style="font-size: 13px;"/>
                                    <t t-esc="widget.kpis.installed_tires or 0"/>
                                </div>
                                <div class="text-muted" style="font-size: 10px; font-weight: 600;">Installed</div>
                            </div>
                            <div class="col-4 border-right pr-1 pl-1">
                                <div class="text-info font-weight-bold" style="font-size: 17px;">
                                    <i class="fa fa-refresh mr-1" style="font-size: 13px;"/>
                                    <t t-esc="widget.kpis.rotated_tires or 0"/>
                                </div>
                                <div class="text-muted" style="font-size: 10px; font-weight: 600;">Rotated</div>
                            </div>
                            <div class="col-4 pr-1 pl-1">
                                <div class="text-danger font-weight-bold" style="font-size: 17px;">
                                    <i class="fa fa-minus-circle mr-1" style="font-size: 13px;"/>
                                    <t t-esc="widget.kpis.removed_tires or 0"/>
                                </div>
                                <div class="text-muted" style="font-size: 10px; font-weight: 600;">Removed</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card 3: Safety & PSI Alerts -->
                <div class="col-xl-3 col-md-6 col-12 mb-3 mb-xl-0">
                    <div class="kpi-card kpi-wear-alerts js_drilldown_wear_alerts" style="cursor: pointer; height: 100%;" title="Click to view Wear Alerts">
                        <div class="kpi-icon"><i class="fa fa-exclamation-triangle"/></div>
                        <div class="kpi-details">
                            <span class="kpi-title">Safety &amp; PSI Alerts</span>
                            <span class="kpi-value text-danger"><t t-esc="widget.kpis.critical_tires"/> Critical</span>
                            <span class="kpi-subtitle"><t t-esc="widget.kpis.warning_tires"/> Warnings Needing Action &gt;</span>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Fleet Wear Efficiency -->
                <div class="col-xl-2 col-md-6 col-12 mb-3 mb-xl-0">
                    <div class="kpi-card kpi-cpkm js_drilldown_cpkm" style="cursor: pointer; height: 100%;" title="Click to view Wear Efficiency">
                        <div class="kpi-icon"><i class="fa fa-tachometer"/></div>
                        <div class="kpi-details">
                            <span class="kpi-title">Wear Efficiency</span>
                            <span class="kpi-value"><t t-esc="widget.kpis.avg_cpkm"/></span>
                            <span class="kpi-subtitle">KM / mm Rate &gt;</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tire Monitoring Report Panel -->
            <div class="dashboard-panel mb-4">
                <!-- Header with Title & Action Controls -->
                <div class="panel-header" style="flex-wrap: wrap; gap: 10px;">
                    <h3>
                        <i class="fa fa-line-chart mr-2"/>Tire Monitoring Report
                        <t t-if="widget.monitoring_report &amp;&amp; widget.monitoring_report.records">
                            <span class="badge badge-info ml-2"><t t-esc="widget.filtered_monitoring_records.length"/> Inspection Records</span>
                        </t>
                    </h3>
                    <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <button class="btn btn-outline-primary btn-sm js_open_monitoring_wizard">
                            <i class="fa fa-file-excel-o mr-1"/> Export Excel Report Wizard
                        </button>
                        <button class="btn btn-outline-info btn-sm js_open_monitoring_list">
                            <i class="fa fa-list mr-1"/> View All Inspections
                        </button>
                        <button class="btn btn-primary btn-sm js_create_monitoring_rec">
                            <i class="fa fa-plus mr-1"/> + New Monitoring
                        </button>
                    </div>
                </div>

                <!-- 2-Column Telemetry Graph & Interactive Filter Section -->
                <div class="row mb-3">
                    <!-- Column 1: Multi-Tab Graph Chart Line & Marker -->
                    <div class="col-md-8 col-12 mb-3 mb-md-0">
                        <div class="chart-box p-3" style="background: #ffffff; border: 1px solid #e9ecef; border-radius: 8px; position: relative;">
                            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                <ul class="nav nav-pills js_chart_tabs flex-wrap" role="tablist" style="gap: 4px;">
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{widget.active_chart_tab == 'rtd' ? 'active' : ''} py-1 px-2 js_select_chart_tab" data-tab="rtd" href="#" style="font-weight: 700; font-size: 11px; cursor: pointer;">
                                            📉 RTD (mm)
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{widget.active_chart_tab == 'mileage' ? 'active' : ''} py-1 px-2 js_select_chart_tab" data-tab="mileage" href="#" style="font-weight: 700; font-size: 11px; cursor: pointer;">
                                            🛣️ Mileage (KM)
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{widget.active_chart_tab == 'wear_pct' ? 'active' : ''} py-1 px-2 js_select_chart_tab" data-tab="wear_pct" href="#" style="font-weight: 700; font-size: 11px; cursor: pointer;">
                                            ⚠️ Wear (%)
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{widget.active_chart_tab == 'efficiency' ? 'active' : ''} py-1 px-2 js_select_chart_tab" data-tab="efficiency" href="#" style="font-weight: 700; font-size: 11px; cursor: pointer;">
                                            ⚡ KM / mm
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{widget.active_chart_tab == 'psi' ? 'active' : ''} py-1 px-2 js_select_chart_tab" data-tab="psi" href="#" style="font-weight: 700; font-size: 11px; cursor: pointer;">
                                            🎈 Pressure (PSI)
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a t-attf-class="nav-link #{widget.active_chart_tab == 'cpk' ? 'active' : ''} py-1 px-2 js_select_chart_tab" data-tab="cpk" href="#" style="font-weight: 700; font-size: 11px; cursor: pointer;">
                                            💰 Est. CPK
                                        </a>
                                    </li>
                                </ul>
                                <small class="text-muted d-none d-lg-inline">Plot by Date</small>
                            </div>
                            <div class="chart-canvas-wrapper" style="position: relative; width: 100%; height: 250px;">
                                <canvas id="js_tire_monitoring_canvas" style="width: 100%; height: 100%;"></canvas>
                            </div>
                            <div class="chart-title-header mt-2 pt-1 border-top d-flex justify-content-between align-items-center">
                                <h5 class="m-0" style="font-size: 12px; font-weight: 700; color: #1e62d0;">
                                    <t t-if="widget.active_chart_tab == 'mileage'">
                                        🛣️ Cumulative KM Mileage Telemetry Trend Chart
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'wear_pct'">
                                        ⚠️ Tire Wear Percentage (%) Degradation Trend Chart
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'efficiency'">
                                        ⚡ Kilometers Per Millimeter (KM / mm) Wear Efficiency Trend Chart
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'psi'">
                                        🎈 Tire Inflation Pressure (PSI) Telemetry Trend Chart
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'cpk'">
                                        💰 Estimated Cost Per Kilometer (Est. CPK Rp/KM) Trend Chart
                                    </t>
                                    <t t-else="">
                                        📉 Remaining Tread Depth (RTD mm) Telemetry Trend Chart
                                    </t>
                                </h5>
                                <span class="badge badge-light text-muted" style="font-size: 10px;">Line &amp; Marker Analytics</span>
                            </div>
                            <div class="chart-description-banner mt-1 p-2" style="background: #f0f4fc; border-left: 4px solid #1e62d0; border-radius: 4px; font-size: 11px; color: #2c3e50;">
                                <i class="fa fa-info-circle text-primary mr-1"/>
                                <span class="js_chart_description_text">
                                    <t t-if="widget.active_chart_tab == 'mileage'">
                                        <strong>KM Mileage:</strong> Plots cumulative distance traveled (KM) recorded during fleet inspections. Used to analyze tire mileage accumulation across vehicles and brands over time.
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'wear_pct'">
                                        <strong>Tire Wear Percentage (%):</strong> Displays tire tread consumption percentage. Yellow line (50%) signals mid-life rotation review; Red line (80%) highlights critical wear requiring immediate retread or replacement planning.
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'efficiency'">
                                        <strong>KM / mm Wear Efficiency:</strong> Measures distance traveled per 1.0 mm of tread wear (KM / mm). Higher values indicate superior tire durability, proper wheel alignment, and optimal driving efficiency.
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'psi'">
                                        <strong>Inflation Pressure (PSI):</strong> Monitors cold inflation pressure in PSI. Green dashed line marks standard target pressure (110 PSI); Red line marks dangerous under-inflation hazard limit (90 PSI).
                                    </t>
                                    <t t-elif="widget.active_chart_tab == 'cpk'">
                                        <strong>Est. Cost per KM (Rp):</strong> Tracks calculated cost per kilometer (Rp/KM) based on initial tire purchase cost divided by projected total mileage. Helps optimize procurement and brand selection.
                                    </t>
                                    <t t-else="">
                                        <strong>Remaining Tread Depth (mm):</strong> Tracks physical tread depth (mm) over time. Red dashed line indicates the 3.0 mm minimum safety threshold; Green line marks 18.0 mm new tire baseline.
                                    </t>
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Interactive Searchable Filters & Period Options -->
                    <div class="col-md-4 col-12">
                        <!-- Period Selector (Years & Quarter/Months) -->
                        <div class="filter-box mb-2" style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 8px 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong style="font-size: 11px; font-weight: 700; color: #1e62d0; text-transform: uppercase;">
                                    <i class="fa fa-calendar mr-1"/> Monitoring Period
                                </strong>
                                <button class="btn btn-link btn-xs js_clear_period_filter p-0" style="font-size: 11px;">Reset</button>
                            </div>
                            <div class="form-row">
                                <div class="col-6">
                                    <select class="form-control form-control-sm js_filter_monitoring_year">
                                        <option value="">-- All Years --</option>
                                        <t t-if="widget.monitoring_report &amp;&amp; widget.monitoring_report.years">
                                            <t t-foreach="widget.monitoring_report.years" t-as="y">
                                                <option t-att-value="y" t-att-selected="widget.selected_year == y ? 'selected' : None">
                                                    <t t-esc="y"/>
                                                </option>
                                            </t>
                                        </t>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <select class="form-control form-control-sm js_filter_monitoring_period">
                                        <option value="">-- All Period --</option>
                                        <optgroup label="Quarters">
                                            <option value="Q1" t-att-selected="widget.selected_period == 'Q1' ? 'selected' : None">Q1 (Jan - Mar)</option>
                                            <option value="Q2" t-att-selected="widget.selected_period == 'Q2' ? 'selected' : None">Q2 (Apr - Jun)</option>
                                            <option value="Q3" t-att-selected="widget.selected_period == 'Q3' ? 'selected' : None">Q3 (Jul - Sep)</option>
                                            <option value="Q4" t-att-selected="widget.selected_period == 'Q4' ? 'selected' : None">Q4 (Oct - Dec)</option>
                                        </optgroup>
                                        <optgroup label="Months">
                                            <option value="1" t-att-selected="widget.selected_period == '1' ? 'selected' : None">January</option>
                                            <option value="2" t-att-selected="widget.selected_period == '2' ? 'selected' : None">February</option>
                                            <option value="3" t-att-selected="widget.selected_period == '3' ? 'selected' : None">March</option>
                                            <option value="4" t-att-selected="widget.selected_period == '4' ? 'selected' : None">April</option>
                                            <option value="5" t-att-selected="widget.selected_period == '5' ? 'selected' : None">May</option>
                                            <option value="6" t-att-selected="widget.selected_period == '6' ? 'selected' : None">June</option>
                                            <option value="7" t-att-selected="widget.selected_period == '7' ? 'selected' : None">July</option>
                                            <option value="8" t-att-selected="widget.selected_period == '8' ? 'selected' : None">August</option>
                                            <option value="9" t-att-selected="widget.selected_period == '9' ? 'selected' : None">September</option>
                                            <option value="10" t-att-selected="widget.selected_period == '10' ? 'selected' : None">October</option>
                                            <option value="11" t-att-selected="widget.selected_period == '11' ? 'selected' : None">November</option>
                                            <option value="12" t-att-selected="widget.selected_period == '12' ? 'selected' : None">December</option>
                                        </optgroup>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Row 1: Vehicle Checkbox List with Search Box (Operating Unit Related) -->
                        <div class="filter-box mb-2" style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 8px 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong style="font-size: 11px; font-weight: 700; color: #1e62d0; text-transform: uppercase;">
                                    <i class="fa fa-truck mr-1"/> Fleet Vehicles
                                </strong>
                                <button class="btn btn-link btn-xs js_clear_vehicle_filter p-0" style="font-size: 10px;">Reset</button>
                            </div>
                            <input type="text" class="form-control form-control-sm mb-1 js_search_vehicle_filter" placeholder="Search vehicle / nopol..." style="font-size: 11px; padding: 2px 6px; height: 26px;"/>
                            <div class="vehicle-checkbox-list" style="max-height: 65px; overflow-y: auto; background: #ffffff; border: 1px solid #dee2e6; border-radius: 4px; padding: 4px 6px;">
                                <t t-if="widget.monitoring_report &amp;&amp; widget.monitoring_report.vehicles &amp;&amp; widget.monitoring_report.vehicles.length">
                                    <t t-foreach="widget.monitoring_report.vehicles" t-as="v">
                                        <div class="form-check vehicle-item-option" style="margin-bottom: 2px;">
                                            <input class="form-check-input js_check_vehicle_filter" type="checkbox" t-att-value="v.name" t-att-id="'veh_chk_' + v.name.replace(' ', '_')"/>
                                            <label class="form-check-label text-truncate" t-att-for="'veh_chk_' + v.name.replace(' ', '_')" style="font-size: 11px; cursor: pointer;">
                                                <t t-esc="v.name"/>
                                            </label>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="text-muted text-center p-1" style="font-size: 11px;">No vehicles available for selected hub</div>
                                </t>
                            </div>
                        </div>

                        <!-- Row 2: Brand Checkbox List with Search Box -->
                        <div class="filter-box mb-2" style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 8px 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong style="font-size: 11px; font-weight: 700; color: #1e62d0; text-transform: uppercase;">
                                    <i class="fa fa-tags mr-1"/> Tire Brands
                                </strong>
                                <button class="btn btn-link btn-xs js_clear_brand_filter p-0" style="font-size: 10px;">Reset</button>
                            </div>
                            <input type="text" class="form-control form-control-sm mb-1 js_search_brand_filter" placeholder="Search brand..." style="font-size: 11px; padding: 2px 6px; height: 26px;"/>
                            <div class="brand-checkbox-list" style="max-height: 65px; overflow-y: auto; background: #ffffff; border: 1px solid #dee2e6; border-radius: 4px; padding: 4px 6px;">
                                <t t-if="widget.monitoring_report &amp;&amp; widget.monitoring_report.brands &amp;&amp; widget.monitoring_report.brands.length">
                                    <t t-foreach="widget.monitoring_report.brands" t-as="b">
                                        <div class="form-check brand-item-option" style="margin-bottom: 2px;">
                                            <input class="form-check-input js_check_brand_filter" type="checkbox" t-att-value="b.name" t-att-id="'brand_chk_' + b.name.replace(' ', '_')"/>
                                            <label class="form-check-label text-truncate" t-att-for="'brand_chk_' + b.name.replace(' ', '_')" style="font-size: 11px; cursor: pointer;">
                                                <t t-esc="b.name"/>
                                            </label>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="text-muted text-center p-1" style="font-size: 11px;">No brands available</div>
                                </t>
                            </div>
                        </div>

                        <!-- Row 3: Tire Size Checkbox List with Search Box -->
                        <div class="filter-box" style="background: #f8f9fa; border: 1px solid #e9ecef; border-radius: 8px; padding: 8px 10px;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong style="font-size: 11px; font-weight: 700; color: #1e62d0; text-transform: uppercase;">
                                    <i class="fa fa-arrows-h mr-1"/> Tire Sizes
                                </strong>
                                <button class="btn btn-link btn-xs js_clear_size_filter p-0" style="font-size: 10px;">Reset</button>
                            </div>
                            <input type="text" class="form-control form-control-sm mb-1 js_search_size_filter" placeholder="Search tire size..." style="font-size: 11px; padding: 2px 6px; height: 26px;"/>
                            <div class="size-checkbox-list" style="max-height: 65px; overflow-y: auto; background: #ffffff; border: 1px solid #dee2e6; border-radius: 4px; padding: 4px 6px;">
                                <t t-if="widget.monitoring_report &amp;&amp; widget.monitoring_report.sizes &amp;&amp; widget.monitoring_report.sizes.length">
                                    <t t-foreach="widget.monitoring_report.sizes" t-as="s">
                                        <div class="form-check size-item-option" style="margin-bottom: 2px;">
                                            <input class="form-check-input js_check_size_filter" type="checkbox" t-att-value="s.name" t-att-id="'size_chk_' + s.name.replace(' ', '_')"/>
                                            <label class="form-check-label text-truncate" t-att-for="'size_chk_' + s.name.replace(' ', '_')" style="font-size: 11px; cursor: pointer;">
                                                <t t-esc="s.name"/>
                                            </label>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div class="text-muted text-center p-1" style="font-size: 11px;">No sizes available</div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Secondary Widgets Panel (PSI Telemetry, Rotation, Forecaster) -->
            <div class="dashboard-panel mb-4">
                <div class="row">
                    <div class="col-md-6 col-12 mb-3 mb-md-0">
                        <!-- Real-Time Tire Pressure (PSI) Telemetry Matrix -->
                        <div class="panel-header">
                            <h3>
                                <i class="fa fa-tachometer mr-2"/>Real-Time Tire Pressure (PSI) Telemetry
                            </h3>
                            <span class="badge badge-info js_drilldown_psi_alerts" style="cursor: pointer;" title="Click to view PSI telemetry detail">
                                <t t-esc="widget.psi_distribution.total_tracked"/> Mounted Tracked &gt;
                            </span>
                        </div>
                        <div class="psi-matrix-container p-2 mb-3" style="background: #f8f9fa; border-radius: 8px;">
                            <div class="d-flex justify-content-between mb-1" style="font-size: 12px; font-weight: 600;">
                                <span>Tire Pressure Status</span>
                                <span>
                                    <span class="text-success mr-2">🟢 Standard (<t t-esc="widget.psi_distribution.normal_count"/>)</span>
                                    <span class="text-warning mr-2">🟡 Low (<t t-esc="widget.psi_distribution.low_count"/>)</span>
                                    <span class="text-danger">🔴 Critical (<t t-esc="widget.psi_distribution.critical_count"/>)</span>
                                </span>
                            </div>
                            <div class="progress" style="height: 14px; border-radius: 7px; overflow: hidden;">
                                <div class="progress-bar bg-success" role="progressbar" t-att-style="'width: ' + widget.psi_distribution.normal_pct + '%'" t-att-title="'Normal PSI: ' + widget.psi_distribution.normal_count + ' tires (' + widget.psi_distribution.normal_pct + '%)'"/>
                                <div class="progress-bar bg-warning" role="progressbar" t-att-style="'width: ' + widget.psi_distribution.low_pct + '%'" t-att-title="'Low PSI: ' + widget.psi_distribution.low_count + ' tires (' + widget.psi_distribution.low_pct + '%)'"/>
                                <div class="progress-bar bg-danger" role="progressbar" t-att-style="'width: ' + widget.psi_distribution.critical_pct + '%'" t-att-title="'Critical PSI: ' + widget.psi_distribution.critical_count + ' tires (' + widget.psi_distribution.critical_pct + '%)'"/>
                            </div>
                            <div class="d-flex justify-content-between mt-2 text-muted" style="font-size: 11px;">
                                <span>Standard: &gt;= 100 PSI</span>
                                <span>Low: 85 - 99 PSI</span>
                                <span>Critical: &lt; 85 PSI</span>
                            </div>
                        </div>

                        <!-- Automated Tire Rotation Opportunities Widget -->
                        <div class="panel-header mt-3">
                            <h3><i class="fa fa-retweet mr-2"/>Recommended Tire Rotation Opportunities</h3>
                        </div>
                        <div class="alert-queue-list mb-3">
                            <t t-if="widget.rotation_recommendations &amp;&amp; widget.rotation_recommendations.length">
                                <t t-foreach="widget.rotation_recommendations" t-as="rot">
                                    <div class="alert-item-card warning js_open_chassis_diagram" t-att-data-vehicle-id="rot.vehicle_id">
                                        <div class="alert-title-row">
                                            <span><i class="fa fa-refresh mr-1"/><t t-esc="rot.action"/></span>
                                            <span class="text-muted"><t t-esc="rot.vehicle_name"/></span>
                                        </div>
                                        <p class="alert-msg"><t t-esc="rot.reason"/></p>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="p-2 text-center text-muted" style="background-color: #f8f9fa; border-radius: 4px;">
                                    <i class="fa fa-check mr-1"/> Steer axle tires currently balanced within equal wear tolerances.
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="col-md-6 col-12">
                        <!-- Predictive Tire Lifespan Replacement Forecaster -->
                        <div class="panel-header">
                            <h3><i class="fa fa-calendar-check-o mr-2"/>Predictive Replacement Forecaster (Next 30 Days)</h3>
                        </div>
                        <div class="alert-queue-list">
                            <t t-if="widget.replacement_forecast &amp;&amp; widget.replacement_forecast.length">
                                <t t-foreach="widget.replacement_forecast" t-as="f">
                                    <div t-attf-class="alert-item-card #{f.urgency} js_open_chassis_diagram" t-att-data-vehicle-id="f.vehicle_id">
                                        <div class="alert-title-row">
                                            <span><t t-esc="f.vehicle_name"/> (Pos <t t-esc="f.pos_code"/>) — Est: <t t-esc="f.est_days"/></span>
                                            <span class="badge badge-danger">RTD <t t-esc="f.rtd"/> mm</span>
                                        </div>
                                        <p class="alert-msg">Serial: <t t-esc="f.serial_number"/> | Priority tire replacement forecast.</p>
                                    </div>
                                </t>
                            </t>
                            <t t-else="">
                                <div class="p-2 text-center text-muted" style="background-color: #f8f9fa; border-radius: 4px;">
                                    <i class="fa fa-shield mr-1"/> All mounted fleet tires have sufficient remaining tread depth.
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CPK Billing Projections & Min-KM Floor Deficit Panel -->
            <div class="dashboard-panel mb-4">
                <div class="panel-header" style="flex-wrap: wrap; gap: 10px;">
                    <h3>
                        <i class="fa fa-money mr-2"/>Monthly CPK Billing Revenue &amp; Minimum Distance Shortfall
                    </h3>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span class="badge badge-info">Period: <t t-esc="widget.cpk_billing_summary.periode_str"/></span>
                        <button class="btn btn-primary btn-sm js_open_billing_wizard">
                            <i class="fa fa-file-text-o mr-1"/> Generate CPK Billing Recap Wizard
                        </button>
                    </div>
                </div>

                <!-- 4 Financial Metric Badges -->
                <div class="financial-metrics-grid mb-3" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px;">
                    <div class="coupling-card text-center p-3" style="background: #eef4ff; border-radius: 8px; border-left: 4px solid #1e62d0;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Total Projected Billing</div>
                        <div style="font-size: 20px; font-weight: 800; color: #1e62d0;"><t t-esc="widget.cpk_billing_summary.projected_billing_str"/></div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Nilai Tagihan (Aktual + Selisih)</div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #e8f8ec; border-radius: 8px; border-left: 4px solid #28a745;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">CPK Contract Hubs</div>
                        <div style="font-size: 20px; font-weight: 800; color: #28a745;"><t t-esc="widget.cpk_billing_summary.cpk_hubs"/> Operating Units</div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Lokasi Billing Operating Unit</div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #fffdf2; border-radius: 8px; border-left: 4px solid #ffc107;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Shortfall Vehicles (&lt; 2.5k KM)</div>
                        <div style="font-size: 20px; font-weight: 800; color: #d97706;"><t t-esc="widget.cpk_billing_summary.deficit_vehicle_count"/> Vehicles</div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Kendaraan di Bawah Minimum KM</div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #fdf2f2; border-radius: 8px; border-left: 4px solid #dc3545;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Shortfall Recovery Value</div>
                        <div style="font-size: 20px; font-weight: 800; color: #dc3545;"><t t-esc="widget.cpk_billing_summary.adjustment_str"/></div>
                        <div style="font-size: 11px; color: #6c757d; margin-top: 2px;">Nilai Tagihan Selisih Minimum KM</div>
                    </div>
                </div>

                <!-- 2-Column CPK Billing Analytics Graph Section -->
                <div class="row mt-3">
                    <!-- Left Chart: Revenue & Deficit Recovery per Operating Hub -->
                    <div class="col-md-7 col-12 mb-3 mb-md-0">
                        <div class="p-3" style="background: #ffffff; border: 1px solid #e9ecef; border-radius: 8px;">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                <strong style="font-size: 12px; font-weight: 700; color: #1e62d0;">
                                    <i class="fa fa-bar-chart mr-1"/> Hub Revenue Output: Actual Distance vs Minimum Shortfall Adjustment
                                </strong>
                                <span class="badge badge-light text-muted" style="font-size: 10px;">Billing Output (Rp)</span>
                            </div>
                            <div class="d-flex align-items-center mb-2" style="gap: 12px; font-size: 11px; font-weight: 600;">
                                <span style="color: #1e62d0;"><i class="fa fa-square mr-1" style="color: #1e62d0;"/> Base Distance Revenue (Rp)</span>
                                <span style="color: #fd7e14;"><i class="fa fa-square mr-1" style="color: #fd7e14;"/> Shortfall Recovery Value (Rp)</span>
                            </div>
                            <div style="position: relative; width: 100%; height: 190px;">
                                <canvas id="js_cpk_hub_revenue_canvas" style="width: 100%; height: 100%;"></canvas>
                            </div>
                            <div class="chart-description-banner mt-2 p-2" style="background: #f0f4fc; border-left: 4px solid #1e62d0; border-radius: 4px; font-size: 11px; color: #2c3e50;">
                                <i class="fa fa-info-circle text-primary mr-1"/>
                                <strong>Hub Billing Breakdown:</strong> Compares <strong>Base Billing</strong> <em>(Actual KM × CPK Rate × Mounted Tires)</em> against <strong>Shortfall Recovery</strong> <em>(Adjustment revenue for vehicles operating below 2,500 KM minimum threshold)</em> for each active CPK Operating Unit.
                            </div>
                        </div>
                    </div>

                    <!-- Right Chart: Vehicle Guarantee Utilization Status -->
                    <div class="col-md-5 col-12">
                        <div class="p-3" style="background: #ffffff; border: 1px solid #e9ecef; border-radius: 8px;">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom">
                                <strong style="font-size: 12px; font-weight: 700; color: #1e62d0;">
                                    <i class="fa fa-pie-chart mr-1"/> Fleet Distance Compliance vs Minimum Floor (2,500 KM)
                                </strong>
                                <span class="badge badge-light text-muted" style="font-size: 10px;">2,500 KM Floor Target</span>
                            </div>
                            <div class="d-flex align-items-center mb-2 flex-wrap" style="gap: 10px; font-size: 11px; font-weight: 600;">
                                <span style="color: #28a745;"><i class="fa fa-circle mr-1" style="color: #28a745;"/> Target Met (≥ 2.5k KM)</span>
                                <span style="color: #d97706;"><i class="fa fa-circle mr-1" style="color: #ffc107;"/> Near Target (2k-2.5k)</span>
                                <span style="color: #dc3545;"><i class="fa fa-circle mr-1" style="color: #dc3545;"/> Shortfall (&lt; 2k KM)</span>
                            </div>
                            <div style="position: relative; width: 100%; height: 190px;">
                                <canvas id="js_cpk_utilization_canvas" style="width: 100%; height: 100%;"></canvas>
                            </div>
                            <div class="chart-description-banner mt-2 p-2" style="background: #f0f4fc; border-left: 4px solid #1e62d0; border-radius: 4px; font-size: 11px; color: #2c3e50;">
                                <i class="fa fa-info-circle text-primary mr-1"/>
                                <strong>Mileage Performance Compliance:</strong> Categorizes fleet vehicles by monthly distance compliance: <strong>Target Met</strong> <em>(≥ 2,500 KM)</em>, <strong>Near Target</strong> <em>(2,000–2,499 KM)</em>, and <strong>Shortfall Deficit</strong> <em>(&lt; 2,000 KM)</em>.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Trailer Coupling & Exchange Telemetry Panel -->
            <div class="dashboard-panel mb-4">
                <div class="panel-header">
                    <h3><i class="fa fa-truck mr-2"/>Trailer Exchange &amp; Fleet Coupling Telemetry</h3>
                    <button class="btn btn-link btn-sm js_drilldown_trailer_exchanges">View All Exchanges &gt;</button>
                </div>

                <!-- Coupling Metric Badges -->
                <div class="coupling-metrics-grid mb-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px;">
                    <div class="coupling-card text-center p-3" style="background: #eef4ff; border-radius: 8px; border-left: 4px solid #1e62d0;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Head Units (Prime Movers)</div>
                        <div style="font-size: 22px; font-weight: 800; color: #1e62d0;"><t t-esc="widget.trailer_coupling_summary.total_heads"/></div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #e8f8ec; border-radius: 8px; border-left: 4px solid #28a745;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Connected Trailers</div>
                        <div style="font-size: 22px; font-weight: 800; color: #28a745;">
                            <t t-esc="widget.trailer_coupling_summary.connected_trailers"/> / <t t-esc="widget.trailer_coupling_summary.total_trailers"/>
                            <small style="font-size: 12px; font-weight: 600;">(<t t-esc="widget.trailer_coupling_summary.coupling_pct"/>%)</small>
                        </div>
                    </div>
                    <div class="coupling-card text-center p-3" style="background: #fff8e6; border-radius: 8px; border-left: 4px solid #ffc107;">
                        <div style="font-size: 11px; font-weight: 700; color: #6c757d; text-transform: uppercase;">Uncoupled Idle Trailers</div>
                        <div style="font-size: 22px; font-weight: 800; color: #d97706;"><t t-esc="widget.trailer_coupling_summary.uncoupled_trailers"/></div>
                    </div>
                </div>

                <!-- Recent Trailer Exchange Feed -->
                <h4 style="font-size: 14px; font-weight: 700; color: #495057; margin-bottom: 10px;">Recent Trailer Exchange Log Activity</h4>
                <div class="alert-queue-list" style="max-height: 240px;">
                    <t t-if="widget.recent_trailer_exchanges &amp;&amp; widget.recent_trailer_exchanges.length">
                        <t t-foreach="widget.recent_trailer_exchanges" t-as="ex">
                            <div class="alert-item-card js_open_trailer_exchange" t-att-data-exchange-id="ex.id" style="border-left-color: #1e62d0; background-color: #f0f4fc; cursor: pointer;">
                                <div class="alert-title-row">
                                    <span><i class="fa fa-exchange mr-1"/><t t-esc="ex.name"/> — <t t-esc="ex.head_name"/></span>
                                    <span class="badge badge-info"><t t-esc="ex.state.toUpperCase()"/></span>
                                </div>
                                <p class="alert-msg">
                                    Swapped: <span class="text-muted"><t t-esc="ex.previous_trailer"/></span> &amp;rarr; <strong><t t-esc="ex.new_trailer"/></strong> | Odo: <strong><t t-esc="ex.odometer ? ex.odometer.toLocaleString() : '0'"/> km</strong> | Hub: <t t-esc="ex.location"/>
                                </p>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="p-3 text-center text-muted" style="background-color: #f8f9fa; border-radius: 6px;">
                            <i class="fa fa-info-circle mr-1"/> No recent trailer exchange logs recorded.
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
